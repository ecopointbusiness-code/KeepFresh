# Copy to .env and fill in. The server loads server/.env automatically.
PORT=3000

# DATABASE: use Firebase Firestore for the hosted app. Place the downloaded service account
# JSON at server/firebase-service-account.json (never include it in a public deployment/archive).
DATABASE_PROVIDER=firebase
FIREBASE_PROJECT_ID=keepfresh-c4e5b
FIREBASE_SERVICE_ACCOUNT_FILE=server/firebase-service-account.json
# Alternatively, configure DATABASE_URL for PostgreSQL/Supabase, or leave DATABASE_PROVIDER
# empty and DATABASE_URL empty to use a local SQLite file.
DATABASE_URL=
DB_FILE=./data/keepfresh.db
JWT_SECRET=change-me-to-a-long-random-string

# Main admin account. Set a strong ADMIN_PASSWORD before starting the hosted app.
# The password is re-applied every time the server starts.
ADMIN_EMAIL=admin@keepfresh.local
ADMIN_PASSWORD=

# Optional recipe generation. Without a key the server uses fridge-matched offline suggestions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# EMAIL IS REQUIRED (EmailJS). Verification codes and alerts are only ever sent by email.
# See README "2. Email (EmailJS)" for where to find each value.
EMAILJS_SERVICE_ID=service_4cplneg
EMAILJS_TEMPLATE_ID=template_vfa2xpv
EMAILJS_PUBLIC_KEY=RFtDoGECqZbY9Q8zQ
EMAILJS_PRIVATE_KEY=ezN4uUhGuIanhpEUcAyuR

# Create optional EmailJS templates for separate designs. Blank values use EMAILJS_TEMPLATE_ID.
EMAILJS_VERIFICATION_TEMPLATE_ID=
EMAILJS_RESET_TEMPLATE_ID=
EMAILJS_WARNING_TEMPLATE_ID=
EMAILJS_ANNOUNCEMENT_TEMPLATE_ID=

# Public https address of your site. Lets the logo show inside emails (leave empty on localhost).
PUBLIC_URL=

# Phone push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@keepfresh.local

# How often the freshness check runs (minutes)
CHECK_MINUTES=15
